---
import Icone from "./ui/Icone.astro";
import Sobretitulo from "./ui/Sobretitulo.astro";
import { objecoes } from "../lib/site";
---

<section id="objecoes" class="bg-white py-16 md:py-28">
  <div class="mx-auto grid max-w-[1200px] gap-6 px-4 md:px-6 lg:grid-cols-[440px_1fr] lg:gap-20">
    <div class="revelar flex flex-col gap-5">
      <Sobretitulo>{objecoes.sobretitulo}</Sobretitulo>
      <h2 class="font-display text-[26px] leading-tight font-bold md:text-[40px]">{objecoes.titulo}</h2>
      <p class="hidden items-center gap-3 rounded-xl bg-azul-50 px-5 py-4 text-[15px] font-semibold lg:flex">
        <Icone nome="carteira" class="shrink-0 text-azul-600" tamanho={22} />
        {objecoes.nota}
      </p>
    </div>
    <ul class="revelar border-b border-linha-200">
      {
        objecoes.itens.map((o) => (
          <li class="flex gap-4 border-t border-linha-200 py-5 md:gap-6 md:py-7">
            <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-azul-50 text-azul-600 md:size-[52px] md:rounded-[14px]">
              <Icone nome={o.icone} tamanho={22} />
            </span>
            <span class="flex flex-col gap-1">
              <span class="font-display text-lg font-bold md:text-[22px]">{o.titulo}</span>
              <span class="text-[15px] leading-relaxed text-tinta-500 md:text-[17px]">{o.texto}</span>
            </span>
          </li>
        ))
      }
    </ul>
    <p class="flex items-center gap-2.5 rounded-xl bg-azul-50 px-4 py-3.5 text-sm font-semibold lg:hidden">
      <Icone nome="carteira" class="shrink-0 text-azul-600" />
      {objecoes.nota}
    </p>
  </div>
</section>
