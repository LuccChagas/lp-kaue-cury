const { nome, class: classe = "", tamanho = 20 } = Astro.props;
const caminhos = icones[nome];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={tamanho}
  height={tamanho}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={classe}
>
  {caminhos.map((d) => <path d={d} />)}
</svg>
