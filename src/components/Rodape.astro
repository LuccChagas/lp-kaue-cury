---
import Logo from "./ui/Logo.astro";
import BotaoInstagram from "./ui/BotaoInstagram.astro";
import { pessoa, rodape } from "../lib/site";
---

<footer class="border-t border-navy-900 bg-navy-950 pt-10 pb-28 md:py-14">
  <div class="mx-auto flex max-w-[1200px] flex-col gap-5 px-4 md:gap-7 md:px-6">
    <div class="flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
      <Logo />
      <div class="flex flex-col gap-4 md:flex-row md:items-center md:gap-6">
        <p class="text-xs text-white/50">Lançamentos <strong class="font-display text-sm font-extrabold tracking-wide text-white/90">{pessoa.empresa}</strong></p>
        <BotaoInstagram class="self-start !h-11" />
      </div>
    </div>
    <div class="h-px bg-white/10"></div>
    <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between md:gap-12">
      <div class="flex flex-col gap-2">
        <p class="text-[13px] font-semibold text-white/80 md:text-sm">{pessoa.nome} · {pessoa.cargo} · {pessoa.creci}</p>
        <p class="text-xs leading-relaxed text-white/50">{rodape.aviso}</p>
        <p class="text-xs leading-relaxed text-white/50">{rodape.avisoNaoOficial}</p>
      </div>
      <a href="/politica-de-privacidade" class="shrink-0 text-[13px] text-white/70 underline">{rodape.linkPrivacidade}</a>
    </div>
  </div>
</footer>
