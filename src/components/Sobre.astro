---
import Cta from "./ui/Cta.astro";
import BotaoInstagram from "./ui/BotaoInstagram.astro";
import Sobretitulo from "./ui/Sobretitulo.astro";
import { pessoa, sobre } from "../lib/site";
---

<section id="kaue" class="bg-navy-950 py-16 md:py-28">
  <div class="mx-auto grid max-w-[1200px] items-center gap-6 px-4 md:px-6 lg:grid-cols-[480px_1fr] lg:gap-20">
    <div class="revelar h-[380px] overflow-hidden rounded-[20px] md:h-[560px] md:rounded-3xl">
      <img src={sobre.foto.src} width={sobre.foto.largura} height={sobre.foto.altura} alt={sobre.foto.alt} loading="lazy" class="size-full object-cover object-[50%_20%]" />
    </div>
    <div class="revelar flex flex-col gap-5 md:gap-6">
      <Sobretitulo tom="ouro">{sobre.sobretitulo}</Sobretitulo>
      <h2 class="font-display text-4xl font-extrabold text-white md:text-[52px]">{pessoa.nome}</h2>
      <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm font-semibold text-white/90 md:text-[17px]">
        <span>{pessoa.cargo}</span>
        <span class="h-4 w-px bg-white/25 md:h-5"></span>
        <img src={pessoa.logoBranco} width="98" height="31" alt={pessoa.empresa} class="h-5 w-auto md:h-6" />
        <span class="h-4 w-px bg-white/25 md:h-5"></span>
        <span>{pessoa.creci}</span>
      </p>
      <p class="text-base leading-relaxed text-white/80 md:text-[19px]">{sobre.texto}</p>
      <dl class="grid grid-cols-3 gap-2.5 md:gap-4">
        {
          sobre.metricas.map((m) => (
            <div class="flex flex-col rounded-xl border border-white/10 bg-navy-900 p-3.5 md:rounded-[14px] md:p-5">
              <dt class="order-2 text-xs text-white/70 md:text-sm">{m.rotulo}</dt>
              <dd class="order-1 font-display text-2xl font-extrabold text-ouro-400 md:text-[30px]">{m.valor}</dd>
            </div>
          ))
        }
      </dl>
      <div class="flex flex-col gap-3 md:flex-row md:items-center md:gap-4">
        <Cta origem="sobre" texto={sobre.cta} class="w-full md:w-auto" />
        <BotaoInstagram class="w-full md:h-14 md:w-auto" />
      </div>
    </div>
  </div>
</section>
