---
import "../styles/global.css";
import { meta, hero } from "../lib/site";

interface Props {
  titulo?: string;
  descricao?: string;
  indexar?: boolean;
}

const { titulo = meta.titulo, descricao = meta.descricao, indexar = true } = Astro.props;
const canonica = new URL(Astro.url.pathname, Astro.site).href;
const ogImagem = new URL("/og.jpg", Astro.site).href;

/* Cada script de rastreamento so entra se o ID existir no ambiente. */
const pixel = import.meta.env.PUBLIC_META_PIXEL_ID;
const ga4 = import.meta.env.PUBLIC_GA4_ID;
const gtm = import.meta.env.PUBLIC_GTM_ID;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonica} />
    {!indexar && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#081423" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={ogImagem} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" as="image" href={hero.imagem.src} fetchpriority="high" />

    {
      gtm && (
        <script is:inline define:vars={{ gtm }}>
          (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtm);
        </script>
      )
    }
    {ga4 && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`} />}
    {
      ga4 && (
        <script is:inline define:vars={{ ga4 }}>
          window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config',ga4);
        </script>
      )
    }
    {
      pixel && (
        <script is:inline define:vars={{ pixel }}>
          !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init',pixel);fbq('track','PageView');
        </script>
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
